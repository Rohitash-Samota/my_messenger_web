# Leave blank to use the built-in Next.js demo API routes.
# For the sibling Spring service use: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# For the sibling Spring STOMP endpoint use: ws://localhost:8080/ws
# When blank, the app derives /ws from NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_SOCKET_URL=
